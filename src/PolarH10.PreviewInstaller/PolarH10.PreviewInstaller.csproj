<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PolarH10.PreviewInstaller</RootNamespace>
    <AssemblyName>PolarH10.PreviewInstaller</AssemblyName>
    <Description>Guided bootstrapper for installing the PolarH10 research preview on Windows.</Description>
    <ApplicationIcon>..\PolarH10.App\Assets\polarh10-stripe-mark.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
